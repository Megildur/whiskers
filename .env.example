# Copy this file to .env and fill in DISCORD_TOKEN. Everything else is optional.

# ---- Required ----
# Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# ---- The AI model (downloaded automatically on the first start) ----
#   nemo-12b      best roleplay and context. ~7.5 GB download, needs about 10 GB of RAM, ~3x slower
#   llama3.1-8b   good roleplay, faster. ~5 GB download, needs about 7 GB of RAM, ~2x slower
#   qwen3-4b      quick, for 4-8 GB servers, weaker at roleplay (default). ~2.5 GB download
#   llama3.2-3b   about 25% faster than qwen3-4b, a little less sharp. ~2 GB, about 3.5 GB of RAM
#   qwen3.5-4b    newest small Qwen, but it reuses cached chat less well on CPU
#   gemma3-4b     nice writing style, slower on CPU
#   qwen2.5-1.5b  tiny and fast for servers with 2-3 GB of RAM, noticeably dumber
# Set for a 12-16 GB server. Use qwen3-4b on a 4-8 GB one.
MODEL=nemo-12b

# CPU threads for the AI. Leave empty to use everything the server allows.
LLM_THREADS=
# Tokens of context shared by all chats. Use 4096 if the server runs out of RAM.
LLM_CONTEXT=8192

# ---- Updates ----
# If your host pulls this code from GitHub, make it match GitHub exactly on every start. A file you
# deleted, edited or uploaded by hand can then never block an update. Your .env, data/, models/ and
# engine/ are never touched. Edit personality.txt on GitHub, not on the server, or it gets replaced.
SYNC_WITH_GIT=true

# ---- Optional ----
# Your Discord user ID(s), comma-separated. Owners can use /whiskers commands in any server.
OWNER_IDS=
# For "it's Tuesday evening" awareness, for example America/New_York or Europe/London
TIMEZONE=America/Los_Angeles
# Let people talk to Whiskers in DMs
ALLOW_DMS=false
# The name the cat answers to and calls itself (slash command descriptions still say Whiskers)
BOT_NAME=Whiskers

# ---- Advanced (the defaults are fine) ----
# Longest reply, in tokens (a token is about 3/4 of a word)
# MAX_REPLY_TOKENS=200
# Higher is more random and creative, lower is more predictable
# TEMPERATURE=0.85
# How many recent messages Whiskers reads before answering
# HISTORY_MESSAGES=24
# How many messages Whiskers sends between journal updates, and the minimum hours between them
# REFLECT_EVERY=25
# REFLECT_MIN_HOURS=2
# Days Whiskers must live in a server before it can learn to communicate beyond meows.
# Use 0 to let it happen as soon as the server teaches it, or a big number to only allow it
# with /whiskers personality speech
# SPEECH_AFTER_DAYS=7
# How many people can wait for a reply before Whiskers reacts with 💤 instead
# MAX_QUEUE=6
# LLM_SLOTS=2
# LLM_CACHE_RAM_MB=512
# LLAMA_CPP_VERSION=b11696
# Any direct .gguf download link, instead of a preset
# MODEL_URL=
# A .gguf file you uploaded yourself (path relative to this folder works)
# MODEL_PATH=
# Only needed for gated Hugging Face models
# HF_TOKEN=

# ---- Use an AI server you run yourself instead of the built-in one ----
# Ollama, LM Studio, a GPU PC, or any OpenAI-compatible API.
# LLM_BACKEND=external
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_NAME=qwen3:4b
# LLM_API_KEY=
